[Unit]
Description=Open VoIP (All-in-One)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=openvoip
Group=openvoip
WorkingDirectory=/opt/open-voip
ExecStart=/opt/open-voip/open-voip -config /opt/open-voip/config.yml
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
