# Copy to .env after migrate-ecs-config.py or deploy/docker/init.py (local only).
COMPOSE_PROJECT_NAME=open-voip
GHCR_REGISTRY=ghcr.io/fangzixia
IMAGE_TAG=main

RUNTIME_DIR=./runtime
SWITCH_STATE_DIR=./runtime/open-switch
CALL_STATE_DIR=./runtime/open-call
SWITCH_UID=10001
SWITCH_GID=10001
CALL_UID=10001
CALL_GID=10001

SWITCH_HEALTH_URL=http://127.0.0.1:8082/health
CALL_HEALTH_URL=http://127.0.0.1:8080/health/ready

# Optional local dev with web container profile:
# WEB_LISTEN=0.0.0.0:8088
# CALL_HTTP_UPSTREAM=127.0.0.1:8080
# WEB_HEALTH_URL=http://127.0.0.1:8088/container-health
