# Copy to /opt/open-voip/.env (ECS) or repo root .env (local). Edit paths and IMAGE_TAG.
GHCR_REGISTRY=ghcr.io/fangzixia
IMAGE_TAG=main

RUNTIME_DIR=./runtime
SWITCH_STATE_DIR=./runtime/open-switch
CALL_STATE_DIR=./runtime/open-call
SWITCH_UID=10001
SWITCH_GID=10001

SWITCH_HEALTH_URL=http://127.0.0.1:8082/health
CALL_HEALTH_URL=http://127.0.0.1:8080/health/ready

WEB_LISTEN=0.0.0.0:8088
CALL_HTTP_UPSTREAM=127.0.0.1:8080
WEB_HEALTH_URL=http://127.0.0.1:8088/container-health

# Optional: mount host binaries instead of image layers (hotfix)
# SWITCH_BINARY_MOUNT=/opt/open-switch/open-switch
# CALL_BINARY_MOUNT=/opt/open-call/open-call

# database.dsn lives in each SWITCH_STATE_DIR/CALL_STATE_DIR/config.yml (not in .env).