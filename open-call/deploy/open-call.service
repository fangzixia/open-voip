[Unit]
Description=Open Call business API and BFF
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=openvoip
Group=openvoip
WorkingDirectory=/opt/open-call
ExecStart=/opt/open-call/open-call -config /opt/open-call/config.yml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
